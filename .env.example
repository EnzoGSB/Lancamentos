# Variáveis de ambiente do Tabelões — copie para .env.local e preencha com valores reais.
#
# OBS: neste repositório o .env.local real foi commitado a pedido do dono.
# O próximo desenvolvedor deve ROTACIONAR estas chaves após assumir o projeto
# (Supabase Dashboard → Settings → API → Reset; OpenAI → API keys → revoke/create).

# Supabase — projeto TABELÃO
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key   # acesso total ao banco — mantenha em segredo

# OpenAI — extração de PDFs (gpt-4o-mini classificação + gpt-4.1 extração)
OPENAI_API_KEY=sua-openai-api-key

# OpenAI — assistente de busca de imóveis (gpt-4o-mini); pode ser chave/projeto separado
OPENAI_API_KEY_BUSCA=sua-openai-api-key-busca

# Extração de PDFs — performance (opcional)
# Faixas em paralelo por PDF (padrão 4, min 1, max 10). Não altera custo por PDF, só tempo.
EXTRACTION_FAIXA_CONCURRENCY=4
# Versão do cache de extração; incremente se mudar regras que invalidem resultados antigos (padrão 1).
EXTRACTION_CACHE_VERSION=1

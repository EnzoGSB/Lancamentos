# Variáveis de ambiente do Tabelões — copie para .env.local e preencha com valores reais.
#
# OBS: neste repositório o .env.local real foi commitado a pedido do dono.
# O próximo desenvolvedor deve ROTACIONAR estas chaves após assumir o projeto
# (Supabase Dashboard → Settings → API → Reset; OpenAI → API keys → revoke/create).

# Supabase — projeto TABELÃO
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key   # acesso total ao banco — mantenha em segredo

# OpenAI — usada na classificação (gpt-4o-mini) e extração (gpt-4.1)
OPENAI_API_KEY=sua-openai-api-key
